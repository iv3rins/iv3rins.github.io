[Unit]
Description=PokeWar authoritative server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pokewar
Group=pokewar
WorkingDirectory=/opt/pokewar/current
EnvironmentFile=/opt/pokewar/shared/.env
ExecStart=/usr/local/bin/node --max-old-space-size=512 apps/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pokewar /var/log/pokewar

[Install]
WantedBy=multi-user.target
