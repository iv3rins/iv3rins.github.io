{
  "name": "@pokewar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node24 --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@pokewar/application": "workspace:*",
    "@pokewar/domain": "workspace:*",
    "@pokewar/persistence": "workspace:*",
    "@pokewar/protocol": "workspace:*",
    "fastify": "5.6.1",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsup": "8.5.0"
  }
}
